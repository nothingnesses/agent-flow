#!/bin/sh
# Inert, opt-in pre-commit hook for the agent-flow checks module.
#
# This file lands at .agents/hooks/pre-commit and is not installed into
# .git/hooks unless `--with-precommit-hook` is selected, or you link it yourself:
#   ln -s ../../.agents/hooks/pre-commit .git/hooks/pre-commit
#
# It delegates to `.agents/checks.toml` through `agent-flow checks --staged`.
# The command runs configured lint and format-check commands over the staged tree
# in temporary isolation; test and mutation entries remain skipped. This hook is
# developer convenience, not task state, review evidence, or a replacement for
# independent product review.
set -eu

# A missing optional tool must not make a repository uncommittable. Install
# agent-flow to enable this local gate.
if ! command -v agent-flow >/dev/null 2>&1; then
	echo "pre-commit: agent-flow is not on PATH; skipping the checks gate." >&2
	echo "pre-commit: install agent-flow to run .agents/checks.toml on commit." >&2
	exit 0
fi

exec agent-flow checks --staged
